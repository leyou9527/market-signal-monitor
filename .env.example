# =========================
# Market Signal Monitor 配置示例
# =========================
#
# 使用方式：
# 1. 复制本文件为 .env
# 2. 把真实值填进去
# 3. 不要把包含真实密钥的 .env 提交到 Git
#
# 设计说明：
# 这份配置文件尽量把“策略”暴露出来，让接手的人不用先读代码也能理解项目行为。
# 真正必填的是 SMTP 配置；数据源 API key 虽然是可选，但强烈建议至少配置一个。


# =========================
# 一、监控规则
# =========================
#
# INDEX_LOOKBACK_DAYS
# 虽然新部署使用 INDEX_*，但这里现在控制的是“标普500指数”的规则。
# 这个窗口会用来找最近 N 个交易日的最高收盘价，
# 然后计算当前收盘相对该高点的回撤。
INDEX_LOOKBACK_DAYS=60

# INDEX_60D_DROP_THRESHOLD_PCT
# 当标普500指数相对最近 60 个交易日最高收盘价的回撤达到或超过这个百分比时，
# 邮件里会把指数的 60 日回撤标记为“触发预警”。
INDEX_60D_DROP_THRESHOLD_PCT=7

# INDEX_YTD_DROP_THRESHOLD_PCT
# 当标普500指数年初至今（YTD）跌幅达到或超过这个百分比时，
# 邮件里会把指数的 YTD 标记为“触发预警”。
INDEX_YTD_DROP_THRESHOLD_PCT=7

# STOCK_LOOKBACK_DAYS
# 8 家科技公司滚动观察窗口，逻辑和指数一样。
STOCK_LOOKBACK_DAYS=60

# STOCK_60D_DROP_THRESHOLD_PCT
# 只要 8 家科技公司里任意一只相对最近 60 个交易日最高收盘价的回撤
# 达到或超过这个阈值，就会触发预警。
STOCK_60D_DROP_THRESHOLD_PCT=20

# TECH_STOCKS
# 当前默认监控的 8 家科技公司。
# 如果后续要扩展股票池，优先确认数据源是否都支持这些代码。
TECH_STOCKS=MSFT,NVDA,META,AAPL,GOOGL,AMZN,TSM,AVGO


# =========================
# 二、数据源请求策略
# =========================
#
# 脚本当前的数据源兜底顺序是：
# - 指数: FMP -> Yahoo -> Stooq
# - 7 只股票: FMP -> Twelve Data -> Yahoo -> Stooq
#
# 设计思路：
# - 先尝试更“正式”的 API
# - 再退到兼容性更强的免费源
# - 如果所有在线源都失败，发异常通知邮件，而不是默默发旧数据

# REQUEST_TIMEOUT_SECONDS
# 单次 HTTP 请求超时秒数。
# 太小容易因为网络抖动误判失败，太大则会拖慢整次日报发送。
REQUEST_TIMEOUT_SECONDS=20

# REQUEST_RETRIES
# 同一个数据源允许的最大重试次数。
# 注意：对于明显不可重试的错误（例如 403、额度耗尽、无效 symbol），
# 脚本会直接切下一个数据源，不会硬重试到次数上限。
REQUEST_RETRIES=3

# REQUEST_RETRY_DELAY_SECONDS
# 普通可重试错误的等待间隔。
REQUEST_RETRY_DELAY_SECONDS=2

# ALERT_COOLDOWN_HOURS
# 这是历史遗留字段，目前主逻辑不再依赖这个字段做告警冷却。
# 暂时保留它，是为了兼容早期部署习惯，避免旧 .env 因字段缺失引发误解。
ALERT_COOLDOWN_HOURS=24

# LOG_FILE
# 本地日志文件路径。建议保持默认，便于统一排查。
LOG_FILE=/opt/market-signal-monitor/logs/market-signal-monitor.log

# FMP_API_KEY
# Financial Modeling Prep 的 API key。
# 不是强制必填，但建议配置。当前实测有些账号/套餐会返回 402/403，
# 所以即使填写了，也仍然需要后面的兜底链路。
FMP_API_KEY=

# TWELVEDATA_API_KEY
# Twelve Data 的 API key。
# 目前主要用于 7 只科技股，不用于指数。
# 它有分钟级额度限制，超出后脚本会自动切到 Yahoo。
TWELVEDATA_API_KEY=

# EODHD_API_KEY
# EOD Historical Data 的 API key。
# 这个 provider 同时用于指数和个股，适合补足 FMP / Twelve Data / Yahoo 当天最新数据不一致的问题。
EODHD_API_KEY=

# EODHD_STOCK_EXCHANGE_CODE
# EODHD 个股默认按美股交易所代码拼接，例如 AAPL.US、MSFT.US。
EODHD_STOCK_EXCHANGE_CODE=US

# EODHD_INDEX_SYMBOLS
# 标普500指数在 EODHD 里的候选代码，脚本会按顺序逐个尝试。
EODHD_INDEX_SYMBOLS=GSPC.INDX,SPX.INDX,SP500.INDX,^GSPC.INDX

# CACHE_DIR
# 这里只保存“最近一次成功抓到的数据快照”，便于排查。
# 重要：缓存不作为当天正式行情来源，不会拿旧数据冒充今天数据发日报。
CACHE_DIR=/opt/market-signal-monitor/data/cache


# =========================
# 三、邮件发送配置
# =========================
#
# 这是整套系统真正必须能工作的部分。
# 推荐使用 Resend；如果没有配置 RESEND_API_KEY，则自动回退到 SMTP。

# EMAIL_PROVIDER
# 可选：resend 或 smtp。
# 留空时：如果配置了 RESEND_API_KEY，会自动使用 resend；否则使用 smtp。
EMAIL_PROVIDER=resend

# RESEND_API_KEY
# Resend API Key。真实密钥只放进 .env，不要提交到 Git。
RESEND_API_KEY=

# RESEND_FROM
# Resend 发件人地址。域名必须已经在 Resend 里验证通过。
RESEND_FROM=Market Monitor <report@example.com>

# RESEND_REQUESTS_PER_SECOND
# 主动限制 Resend API 请求速度。默认 4 次/秒，低于官方常见的 5 次/秒上限。
RESEND_REQUESTS_PER_SECOND=4

# RESEND_MAX_ATTEMPTS / RESEND_RETRY_DELAY_SECONDS
# 遇到 429、5xx 或临时网络错误时的总尝试次数和首次退避秒数。
# 后续重试采用指数退避，并优先遵循 Resend 返回的 Retry-After。
RESEND_MAX_ATTEMPTS=4
RESEND_RETRY_DELAY_SECONDS=1

# SMTP_RECIPIENT
# 邮件主收件人地址，会显示在邮件 To 里。
SMTP_RECIPIENT=your_email@example.com

# SMTP_BCC
# 可选。密送收件人地址，适合放员工邮箱；多个地址用英文逗号分隔。
# 使用 SMTP 时会作为 BCC 发送；使用 Resend 时会逐个单独发送，每个人的 To 都是自己。
# Resend 模式下单个地址失败不会阻断后续地址，所有地址处理完后会汇总失败结果。
SMTP_BCC=

# SMTP 备用配置
# 如果 EMAIL_PROVIDER=smtp，下面这些 SMTP 配置必须填写。

# SMTP_HOST
# 邮件服务器地址。
# 例如：
# - QQ 邮箱: smtp.qq.com
# - Gmail: smtp.gmail.com
# - Outlook: smtp.office365.com
SMTP_HOST=smtp.example.com

# SMTP_PORT
# 常见端口：
# - 465: SSL
# - 587: STARTTLS
SMTP_PORT=587

# SMTP_USER
# SMTP 登录用户名，通常就是发件邮箱地址。
SMTP_USER=your_account@example.com

# SMTP_PASSWORD
# SMTP 登录密码。
# 注意：很多邮箱这里填的不是邮箱登录密码，而是“授权码 / App Password”。
SMTP_PASSWORD=replace_with_app_password

# SMTP_SENDER
# 邮件发件人地址，通常和 SMTP_USER 一致。
SMTP_SENDER=your_account@example.com


# =========================
# 四、SMTP 加密方式
# =========================
#
# 这两个开关不要同时设为 true。
# 通常二选一：
# - 465 端口配 SMTP_USE_SSL=true
# - 587 端口配 SMTP_USE_STARTTLS=true

SMTP_USE_SSL=false
SMTP_USE_STARTTLS=true


# =========================
# 五、状态文件
# =========================
#
# STATE_FILE
# 用来记录：
# - 上一次已成功发送的市场日期
# - 今天是否已经发过“异常通知”
#
# 只有邮件真正发送成功后，脚本才会更新这里的“已处理日期”。
# 这样做是为了避免“邮件其实没发出去，但状态却被记成发过”的隐性漏报。
#
# 如果你不改，程序默认会写到项目目录下的 data/state.json。
# 如需自定义，取消下面这一行的注释并改成你自己的路径。

# STATE_FILE=/opt/market-signal-monitor/data/state.json
